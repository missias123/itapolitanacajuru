{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "vars": "all", "args": "none" }],
    "no-undef": "warn",
    "no-console": "off",
    "no-debugger": "error",
    "no-unreachable": "error",
    "no-duplicate-case": "error",
    "no-empty": "warn",
    "no-extra-semi": "warn",
    "eqeqeq": ["warn", "always", { "null": "ignore" }],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error"
  },
  "globals": {
    "gtag": "readonly",
    "dataLayer": "writable",
    "motorEstrelas": "writable",
    "abrirItaBot": "writable",
    "mostrarResposta": "writable",
    "voltarNivel": "writable"
  },
  "ignorePatterns": [
    "node_modules/",
    "*.min.js",
    "mascote.min.js"
  ]
}
